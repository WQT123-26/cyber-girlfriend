# 赛博女友 / cyber-girlfriend —— 环境变量示例
# 用法：把本文件复制为 backend/.env，按需修改。
# 所有变量前缀均为 CG_ ；不配置任何值也能跑通（默认使用 mock 演示模型）。
#
# 注意：留空 = 使用默认值；启动后也可以在网页「设置」页里修改，
#       运行期修改的值保存在数据库表 app_configs 中，优先级高于本文件与默认值。

# ---------- 数据库 ----------
# 默认即 backend/data/cyber_gf.db，一般无需修改
# CG_DATABASE_URL=sqlite:///./data/cyber_gf.db

# ---------- LLM 提供方 ----------
# mock    = 内置演示模型（无需联网、无需 Key）
# openai  = 任何 OpenAI 兼容接口（OpenAI / DeepSeek / 通义 / 硅基流动 / vLLM ...）
# ollama  = 本地 Ollama
CG_LLM_PROVIDER=mock

# openai 兼容接口填到 /v1 为止；ollama 填 http://localhost:11434
CG_LLM_BASE_URL=
CG_LLM_API_KEY=
CG_LLM_MODEL=
CG_LLM_TEMPERATURE=0.8

# ---------- 记忆与上下文 ----------
CG_MEMORY_TOP_K=5
CG_RECENT_WINDOW=12
CG_REFLECT_EVERY=6

# ---------- 世界书 / Lorebook ----------
# 是否启用世界书关键词注入；关掉后角色卡里的 lorebook 不再参与提示词编排
CG_LORE_ENABLED=true
# 单轮世界书注入预算（字符数，近似 token），超出预算的条目按优先级截断
CG_LORE_BUDGET=1200
# 关键词匹配所扫描的最近消息条数（越大越容易命中，也越费 token）
CG_LORE_SCAN_WINDOW=12

# ---------- 聊天记录脱敏 ----------
# 默认开启：导出 / 备份 / 展示时对手机号、身份证、邮箱、银行卡、QQ、URL 打码
CG_DESENSITIZE_ENABLED=true
# 自定义关键词黑名单，逗号或换行分隔；命中即打码。留空表示只用内置规则
# CG_DESENSITIZE_BLACKLIST=某公司,某项目代号
